{
    "name": "ekddigital/ekdsend-php",
    "description": "Official PHP SDK for the EKDSend API - Email, SMS, and Voice communications",
    "version": "1.1.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "EKD Digital",
            "email": "support@ekddigital.com",
            "homepage": "https://es.ekddigital.com"
        }
    ],
    "homepage": "https://github.com/ekddigital/ekdsend-php",
    "keywords": [
        "ekdsend",
        "email",
        "sms",
        "voice",
        "api",
        "sdk",
        "transactional-email",
        "communications"
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EKDSend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EKDSend\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src",
        "cs-fix": "php-cs-fixer fix src"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
